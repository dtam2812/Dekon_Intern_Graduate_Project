-
  const brand = '#4f46e5'
  const blue = '#2563eb'
  const ink = '#111827'
  const muted = '#6b7280'
  const line = '#e5e7eb'
  const pageBg = '#f3f4f6'
  const font = "-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif"
  const money = (n) => Number(n || 0).toLocaleString('vi-VN') + ' ₫'
  const shop = shopName || 'Our Shop'
  const who = name || 'there'
  const items = (order && order.orderItems) || []
  const a = (order && order.shippingAddress) || {}
  const address = [a.houseNumber, a.street, a.ward, a.district, a.city, a.country].filter(Boolean).join(', ')
  const orderCode = String((order && order.id) || '').slice(-8).toUpperCase()
  const payment = { COD: 'Cash on delivery', Banking: 'Bank transfer' }[order && order.paymentMethod] || (order && order.paymentMethod) || ''
  const isPaid = String((order && order.paymentStatus) || '').toLowerCase() === 'paid'
  const isCod = (order && order.paymentMethod) === 'COD'
  const label = `margin:0 0 6px;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:${muted};`
  const text = `margin:0 0 4px;font-size:15px;line-height:22px;color:${ink};`
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    title Your order #{orderCode} is on its way
  body(style=`margin:0;padding:0;background:${pageBg};`)
    //- Preheader
    div(style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:#f3f4f6;")
      | Good news! Your order ##{orderCode} has been handed to the carrier and is on its way.
    table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style=`background:${pageBg};`)
      tr
        td(align="center" style="padding:24px 12px;")
          table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style=`max-width:600px;background:#ffffff;border:1px solid ${line};border-radius:12px;overflow:hidden;font-family:${font};`)
            //- Header
            tr
              td(style=`background:${brand};padding:22px 32px;`)
                span(style="font-size:20px;font-weight:700;letter-spacing:0.3px;color:#ffffff;") #{shop}
            //- Status + title + intro
            tr
              td(style="padding:32px 32px 8px;")
                span(style=`display:inline-block;padding:4px 12px;border-radius:999px;background:#dbeafe;color:${blue};font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;`) 🚚 Shipping
                p(style=`${label}margin-top:16px;`) Order ##{orderCode}
                h1(style=`margin:0 0 12px;font-size:26px;line-height:32px;font-weight:700;color:${ink};`) Your order is on its way
                p(style=`margin:0;font-size:15px;line-height:24px;color:${muted};`)
                  | Hi #{who}, good news! Your order has been handed to the carrier and is heading to you. Please keep your phone nearby so the courier can reach you.
            //- Shipment details (all optional)
            if carrier || trackingCode || estimatedDelivery
              tr
                td(style="padding:16px 32px 0;")
                  table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;")
                    tr
                      td(style="padding:16px 18px;")
                        p(style=label) Shipment details
                        if carrier
                          p(style=text) Carrier: 
                            strong #{carrier}
                        if trackingCode
                          p(style=text) Tracking code: 
                            strong #{trackingCode}
                        if estimatedDelivery
                          p(style=text) Estimated delivery: 
                            strong #{estimatedDelivery}
            //- Track button (optional)
            if trackingUrl
              tr
                td(style="padding:16px 32px 0;")
                  table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0")
                    tr
                      td(align="center" style=`background:${blue};border-radius:8px;`)
                        a(href=trackingUrl target="_blank" style="display:block;padding:14px 20px;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;") Track your order
            //- Payment note
            if isPaid
              tr
                td(style="padding:16px 32px 0;")
                  table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;")
                    tr
                      td(style="padding:12px 16px;font-size:14px;line-height:20px;color:#16a34a;")
                        strong Already paid.
                        |  There is nothing to pay when your order arrives.
            else if isCod
              tr
                td(style="padding:16px 32px 0;")
                  table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;")
                    tr
                      td(style="padding:12px 16px;font-size:14px;line-height:20px;color:#92400e;")
                        strong Cash on delivery.
                        |  Please have #{money(order && order.total)} ready for the courier.
            //- Order summary
            tr
              td(style="padding:24px 32px 8px;")
                p(style=label) Order summary
                table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0")
                  each item in items
                    tr
                      td(valign="top" style=`padding:12px 0;border-bottom:1px solid ${line};`)
                        div(style=`font-size:15px;font-weight:600;color:${ink};`) #{item.productName}
                        div(style=`margin-top:2px;font-size:13px;color:${muted};`) #{item.quantity} × #{money(item.orderedPrice)}
                      td(align="right" valign="top" style=`padding:12px 0 12px 16px;border-bottom:1px solid ${line};font-size:15px;font-weight:600;color:${ink};white-space:nowrap;`) #{money(item.orderedPrice * item.quantity)}
                  tr
                    td(style=`padding:16px 0 0;font-size:16px;font-weight:700;color:${ink};`) Total
                    td(align="right" style=`padding:16px 0 0 16px;font-size:18px;font-weight:700;color:${brand};white-space:nowrap;`) #{money(order && order.total)}
            //- Delivery + payment
            tr
              td(style="padding:16px 32px 24px;")
                table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style=`background:#f9fafb;border:1px solid ${line};border-radius:8px;`)
                  tr
                    td(style="padding:16px 18px;")
                      p(style=label) Deliver to
                      p(style=text)
                        strong #{order && order.receiverName}
                      p(style=text) #{order && order.receiverPhone}
                      p(style=text) #{address}
                      if a.note
                        p(style=`margin:6px 0 0;font-size:13px;color:${muted};`) Note: #{a.note}
                      if payment
                        p(style=`${label}margin-top:16px;`) Payment
                        p(style=text) #{payment}
            //- Footer
            tr
              td(align="center" style=`background:#f9fafb;border-top:1px solid ${line};padding:16px 32px;font-size:12px;color:#9ca3af;`) © #{new Date().getFullYear()} #{shop}
