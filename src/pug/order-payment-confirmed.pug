-
  const brand = '#4f46e5'
  const green = '#16a34a'
  const ink = '#111827'
  const muted = '#6b7280'
  const line = '#e5e7eb'
  const pageBg = '#f3f4f6'
  const font = "-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif"
  const money = (n) => Number(n || 0).toLocaleString('vi-VN') + ' ₫'
  const shop = shopName || 'Our Shop'
  const who = name || 'there'
  const items = (order && order.orderItems) || []
  const a = (order && order.shippingAddress) || {}
  const isNumeric = (v) => v != null && /^\d+$/.test(String(v).trim())
  const hasValue = (v) => v != null && String(v).trim() !== ''
  const streetPart = hasValue(a.street)
  ? (isNumeric(a.street) ? `Street ${a.street}` : `${a.street} Street`)
  : ''
  const wardPart = hasValue(a.ward)
  ? (isNumeric(a.ward) ? `Ward ${a.ward}` : `${a.ward} Ward`)
  : ''
  const DistrictPart = a.district != null
  ? (isNumeric(a.district) ? `District ${a.district}` : `${a.district} District`)
  : ''
  const address = [
  a.houseNumber,
  streetPart,
  wardPart,
  DistrictPart,
  a.city ? `${a.city} City` : '',
  a.country,
  ].filter(Boolean).join(', ')
  const orderCode = String((order && order.id) || '').slice(-8).toUpperCase()
  const payment = { COD: 'Cash on delivery', Banking: 'Bank transfer' }[order && order.paymentMethod] || (order && order.paymentMethod) || ''
  const label = `margin:0 0 6px;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:${muted};`
  const text = `margin:0 0 4px;font-size:15px;line-height:22px;color:${ink};`
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    title Payment received for order #{orderCode}
  body(style=`margin:0;padding:0;background:${pageBg};`)
    //- Preheader
    div(style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:#f3f4f6;")
      | We've confirmed your payment for order ##{orderCode}. Thank you!
    table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style=`background:${pageBg};`)
      tr
        td(align="center" style="padding:24px 12px;")
          table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style=`max-width:600px;background:#ffffff;border:1px solid ${line};border-radius:12px;overflow:hidden;font-family:${font};`)
            //- Header
            tr
              td(style=`background:${brand};padding:22px 32px;`)
                span(style="font-size:20px;font-weight:700;letter-spacing:0.3px;color:#ffffff;") #{shop}
            //- Status + title + intro
            tr
              td(style="padding:32px 32px 8px;")
                span(style=`display:inline-block;padding:4px 12px;border-radius:999px;background:#dcfce7;color:${green};font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;`) ✓ Payment received
                p(style=`${label}margin-top:16px;`) Order ##{orderCode}
                h1(style=`margin:0 0 12px;font-size:26px;line-height:32px;font-weight:700;color:${ink};`) We've received your payment
                p(style=`margin:0;font-size:15px;line-height:24px;color:${muted};`)
                  if order && order.paymentMethod === 'Banking'
                    | Hi #{who}, we've confirmed your bank transfer for this order. Your payment status has been updated to Paid.
                  else
                    | Hi #{who}, we've received your payment for this order. Your payment status has been updated to Paid.
            //- Order summary
            tr
              td(style="padding:24px 32px 8px;")
                p(style=label) Order summary
                table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0")
                  each item in items
                    tr
                      td(valign="top" style=`padding:12px 0;border-bottom:1px solid ${line};`)
                        div(style=`font-size:15px;font-weight:600;color:${ink};`) #{item.productName}
                        div(style=`margin-top:2px;font-size:13px;color:${muted};`) #{item.quantity} × #{money(item.orderedPrice)}
                      td(align="right" valign="top" style=`padding:12px 0 12px 16px;border-bottom:1px solid ${line};font-size:15px;font-weight:600;color:${ink};white-space:nowrap;`) #{money(item.orderedPrice * item.quantity)}
                  tr
                    td(style=`padding:16px 0 0;font-size:16px;font-weight:700;color:${ink};`) Total
                    td(align="right" style=`padding:16px 0 0 16px;font-size:18px;font-weight:700;color:${brand};white-space:nowrap;`) #{money(order && order.total)}
            //- Payment + delivery
            tr
              td(style="padding:16px 32px 8px;")
                table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style=`background:#f9fafb;border:1px solid ${line};border-radius:8px;`)
                  tr
                    td(style="padding:16px 18px;")
                      if payment
                        p(style=label) Payment
                        p(style=text)
                          strong Status:&nbsp;
                          | Paid
                        p(style=text) #{payment}
                      p(style=`${label}margin-top:16px;`) Shipping to
                      p(style=text)
                        strong #{order && order.receiverName}
                      p(style=text) #{order && order.receiverPhone}
                      p(style=text) #{address}
            //- Help text
            tr
              td(style="padding:16px 32px 24px;")
                p(style=`margin:0;font-size:13px;line-height:20px;color:${muted};`)
                  | Think this isn't right? Please contact us
                  if supportEmail
                    |  at
                    |
                    a(href=`mailto:${supportEmail}` style=`color:${brand};`) #{supportEmail}
                  | .
            //- Footer
            tr
              td(align="center" style=`background:#f9fafb;border-top:1px solid ${line};padding:16px 32px;font-size:12px;color:#9ca3af;`) © #{new Date().getFullYear()} #{shop}
