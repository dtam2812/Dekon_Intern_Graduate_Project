# ===== MongoDB Atlas =====
# If the password contains special characters (@ : / # ?), it must be URL-encoded in MONGODB_URI
MONGODB_USERNAME=your_atlas_username
MONGODB_PASSWORD=your_atlas_password
# Include the database name before the "?"
MONGODB_URI=mongodb+srv://your_atlas_username:your_atlas_password@cluster0.xxxxx.mongodb.net/your_db_name?retryWrites=true&w=majority

# ===== JWT / Token =====
# Use a long random string (generate with: openssl rand -hex 32), a different value for each secret
JWT_SECRET=change_me_to_a_long_random_string
# Access token lifetime, e.g. 15m
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days, e.g. 7
REFRESH_TOKEN_EXPIRES_DAYS=7
# Secret used to sign order confirmation/cancellation tokens sent via email
ORDER_TOKEN_SECRET=change_me_to_another_long_random_string

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match the Authorized redirect URI in Google Cloud Console character for character
# Dev/Docker local: http://localhost:3000/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
SESSION_SECRET=change_me_to_a_session_secret

# ===== Environment =====
NODE_ENV=development

# ===== SMTP (sending order confirmation emails) =====
SMTP_HOST=smtp.gmail.com
# 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Gmail: use an App Password, not your login password
SMTP_PASS=your_app_password
SMTP_FROM="Your Shop <your_email@gmail.com>"
SHOP_NAME=Your Shop

# ===== Frontend =====
# Used to build the order confirmation/cancellation links in emails and to configure CORS
# Dev: http://localhost:5173 
FRONTEND_URL=http://localhost:5173